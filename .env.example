# Copy to .env.local for local development, and set the same keys in your host's
# environment settings for production. Never commit real values.

# --- Supabase (Project Settings → API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon"/publishable key — safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET. Server only. Bypasses RLS — used for lead inserts and rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SECRET. Only used by `npm run db:migrate` (not by the running app).
# Project Settings → Database → Connection string (direct or "Session pooler").
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
# The direct db.* host is IPv6-only. If your network has no IPv6, set the pooler
# host from Connect → Session pooler and migrations will route through it.
SUPABASE_POOLER_HOST=aws-0-your-region.pooler.supabase.com

# --- Admin login ------------------------------------------------------------
# Signs admin session JWTs (HS256). At least 32 random characters. Keep secret —
# changing it signs every admin out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
# Admin passwords live in the database as scrypt hashes. Set one with:
#   ADMIN_PASSWORD='…' npm run admin:password -- admin@example.com

# --- App URLs ---------------------------------------------------------------
# Public URL of THIS app (used in admin sign-in links and notification emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Main Kupi website (logo link, "Explore Kupi" button).
NEXT_PUBLIC_MAIN_SITE_URL=https://kupi-dzon.onrender.com
# Privacy policy shown beside the consent checkbox. Defaults to <main site>/privacy.
NEXT_PUBLIC_PRIVACY_URL=https://kupi-dzon.onrender.com/privacy

# --- Spam protection --------------------------------------------------------
# Random secret used to hash IPs for rate limiting (raw IPs are never stored).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=change-me-to-a-long-random-string
# Optional: other sites allowed to POST to /api/leads (comma separated origins),
# e.g. if you embed the form on the main website.
LEAD_ALLOWED_ORIGINS=

# --- Email: follow-up emails to leads + new-lead alerts to admins -----------
# Configure ONE provider. Without one, admins can still use "Open in my email app".
#
# Option A — SMTP, e.g. Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# Option B — Resend (https://resend.com), needs a verified domain
RESEND_API_KEY=
#
# Sender shown to recipients. For Gmail this must be the same Gmail address.
EMAIL_FROM="Kupi <you@gmail.com>"
# Optional: who receives new-lead alerts (comma separated). Blank = no alerts.
LEAD_NOTIFY_EMAIL=
